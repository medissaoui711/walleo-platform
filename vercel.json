{
  "version": 2,
  "builds": [
    {
      "src": "web/merchant-dashboard/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/web/merchant-dashboard/$1"
    }
  ],
  "env": {
    "VITE_API_URL": "https://your-backend.onrender.com"
  }
}
